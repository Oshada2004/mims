# Copy to .env and fill in real values. docker-compose.yml and the backend both read .env.
# Never commit .env.

# --- Database (MySQL in docker-compose) ---
DB_HOST=database
DB_PORT=3306
DB_NAME=mims_db
DB_USER=mims
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-too

# --- Backend ---
PORT=5000
FRONTEND_URL=http://localhost:5173
# Bank time zone as a UTC offset; MySQL and the backend must agree.
BANK_TIMEZONE=+05:30

# --- Email --- (see README "Sending real emails")
# MAIL_TRANSPORT: smtp (default) or http (Brevo HTTP API, for hosts that block SMTP ports).
MAIL_TRANSPORT=smtp
# Local default: Mailpit catches every email, inbox at http://localhost:8025 (nothing reaches real inboxes).
SMTP_HOST=mailpit
SMTP_PORT=1025
# true for port 465 (TLS from the start); leave empty to decide from the port.
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
MAIL_FROM=MIMS <no-reply@mims.local>
# Gmail instead of Mailpit (App Password, not your normal password; MAIL_FROM must be the same Gmail address):
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=465
#   SMTP_SECURE=true
#   SMTP_USER=your.address@gmail.com
#   SMTP_PASS=your-16-letter-app-password
#   MAIL_FROM=MIMS Bank <your.address@gmail.com>
# Only for MAIL_TRANSPORT=http (Brevo API key; MAIL_FROM must be a sender verified in Brevo):
MAIL_API_KEY=

# --- One-time codes ---
# Required, at least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
OTP_SECRET=
