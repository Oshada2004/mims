# Copy to .env and fill in real values. docker-compose.yml and the backend both read .env.
# Never commit .env.

# --- Database (MySQL in docker-compose) ---
DB_HOST=database
DB_PORT=3306
DB_NAME=mims_db
DB_USER=mims
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-too

# --- Backend ---
PORT=5000
FRONTEND_URL=http://localhost:5173
# Bank time zone as a UTC offset; MySQL and the backend must agree.
BANK_TIMEZONE=+05:30

# --- Email (local: Mailpit, inbox at http://localhost:8025) ---
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
MAIL_FROM=MIMS <no-reply@mims.local>

# --- One-time codes ---
# Required, at least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
OTP_SECRET=
